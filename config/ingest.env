# Rows the daemon queues per refill. The daemon cannot notice SIGTERM
# while a batch is in flight, so a very large value slows pod shutdown.
POSDA_INGEST_BATCH_SIZE=1000
# Pause after a refill that found nothing.
POSDA_INGEST_IDLE_SLEEP=10
# Delay between queue-depth checks.
POSDA_INGEST_TICK=1

# Defect fixes, off by default. See docs/programming/Ingest-Fixes.md before
# turning any of them on -- five change row counts in tables that analyst
# queries read.

# Keeping this one off for now, as it notes that skipping it will cause
# the parser to load the pixel data into memory. Need to fix that!
#POSDA_INGEST_FIX_LOAD_LARGE_VALUES=1
POSDA_INGEST_FIX_LOOKUP_UPSERT=1
POSDA_INGEST_FIX_ATOMIC_IMPORT=1
POSDA_INGEST_FIX_XFR_STX=1
POSDA_INGEST_FIX_ORIGINAL_SPECIALIZED_SOP_CLASS=1
POSDA_INGEST_FIX_DOSE_NORMALIZATION_POINT=1
POSDA_INGEST_FIX_WINDOW_LEVEL_DUPLICATION=1
POSDA_INGEST_FIX_ELEMENTAL_COMPOSITION=1
POSDA_INGEST_FIX_FRACTION_RELATED_DOSE=1
POSDA_INGEST_FIX_BEAM_GENERAL_ACCESSORY=1
POSDA_INGEST_FIX_PRESCRIPTION_ORGAN_AT_RISK_TAGS=1
