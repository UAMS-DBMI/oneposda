def human_size(size: float, precision: int = 2) -> str:
    """Format a byte count as a human readable string."""
    suffixes = ["B", "KB", "MB", "GB", "TB"]
    index = 0
    while size > 1024 and index < len(suffixes) - 1:
        index += 1
        size = size / 1024.0
    return f"{size:.{precision}f}{suffixes[index]}"


def read_plist(filename: str) -> Iterator[dict[str, Any]]:
    """Yield each entry of a plist file."""
    with open(filename) as infile:
        for lineno, line in enumerate(infile, start=1):
            line = line.strip()
            if not line:
                continue
            try:
                yield json.loads(line)
            except json.JSONDecodeError as err:
                raise ValueError(f"{filename}:{lineno}: invalid JSON: {err}") from err


@dataclass
class SizeStats:
    """Summary statistics over the file sizes in a plist."""

    count: int
    total: int
    minimum: int
    maximum: int
    mean: float
    stdev: float


def summarize_sizes(sizes: Iterator[int]) -> SizeStats:
    """Compute size statistics in a single streaming pass.

    Plists for a full disk can hold tens of millions of entries, so the sizes
    are accumulated rather than held in memory.
    """
    count = 0
    total = 0
    total_squares = 0
    minimum = None
    maximum = None

    for size in sizes:
        count += 1
        total += size
        total_squares += size * size
        if minimum is None or size < minimum:
            minimum = size
        if maximum is None or size > maximum:
            maximum = size

    if count == 0:
        raise ValueError("plist contains no entries")

    mean = total / count
    # Population standard deviation, matching numpy's default.
    variance = max(total_squares / count - mean * mean, 0.0)

    return SizeStats(
        count=count,
        total=total,
        minimum=minimum,
        maximum=maximum,
        mean=mean,
        stdev=math.sqrt(variance),
    )


def report(plist: str) -> None:
    """Print a statistical report about the files in a plist."""
    stats = summarize_sizes(entry["size"] for entry in read_plist(plist))

    print(
        f"""\
Report:
    Length: {stats.count}
    Total:  {human_size(stats.total)}
    Min:    {human_size(stats.minimum)}
    Max:    {human_size(stats.maximum)}
    Mean:   {human_size(stats.mean)}
    Std:    {human_size(stats.stdev)}
"""
    )


