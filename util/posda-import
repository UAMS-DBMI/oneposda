def md5sum(filename: str) -> str:
    """Return the hex md5 digest of a file."""
    digest = hashlib.md5()
    with open(filename, "rb") as infile:
        for chunk in iter(lambda: infile.read(4096), b""):
            digest.update(chunk)
    return digest.hexdigest()


class RetryPolicy:
    """How hard to try before giving up on a request."""

    def __init__(
        self,
        retries: int = DEFAULT_RETRIES,
        delay: float = DEFAULT_RETRY_DELAY,
        sleep: Callable[[float], None] = time.sleep,
    ) -> None:
        self.retries = retries
        self.delay = delay
        self.sleep = sleep

    def backoff(self, attempt: int) -> float:
        """Seconds to wait before attempt number `attempt` (1-based retry).

        Doubles each time, capped, with jitter so that a batch of workers
        hitting a struggling server don't all retry in lockstep.
        """
        base = min(self.delay * (2 ** (attempt - 1)), MAX_RETRY_DELAY)
        return base * random.uniform(0.5, 1.0)


def is_retryable(error: Exception | None, status: int | None) -> bool:
    """Decide whether a failed request is worth repeating."""
    if error is not None:
        # Connection resets, timeouts, DNS failures: all transient.
        return True
    return status in RETRYABLE_STATUSES


def request_with_retry(
    send: Callable[[], Any], description: str, policy: RetryPolicy
) -> Any:
    """Call send() until it returns a non-retryable response.

    `send` must build and issue the request from scratch each time it is
    called -- it is not enough to reuse a prepared request, because an
    upload body is a stream that a failed attempt may already have
    consumed.

    Returns the final response. Raises the last exception if every attempt
    ended in an error rather than a response.
    """
    import requests

    last_error: Exception | None = None

    for attempt in range(policy.retries + 1):
        if attempt > 0:
            wait = policy.backoff(attempt)
            printe(
                f"Retrying {description} in {wait:.1f}s "
                f"(attempt {attempt + 1} of {policy.retries + 1})"
            )
            policy.sleep(wait)

        response = None
        last_error = None
        try:
            response = send()
        except requests.RequestException as err:
            last_error = err

        status = None if response is None else response.status_code
        if not is_retryable(last_error, status):
            return response

        reason = last_error if last_error is not None else f"HTTP {status}"
        printe(f"{description} failed: {reason}")

    if response is not None:
        return response
    raise last_error


class PosdaImportApi:
    """Thin client for the Posda import API."""

    def __init__(self, base_url: str, policy: RetryPolicy) -> None:
        self.url = f"{base_url.rstrip('/')}/papi/v1/import/"
        self.policy = policy

    def create_event(self, comment: str) -> int:
        import requests

        response = request_with_retry(
            lambda: requests.put(self.url + "event", params={"source": comment}),
            "creating import event",
            self.policy,
        )
        response.raise_for_status()
        return response.json()["import_event_id"]

    def close_event(self, import_event_id: int) -> None:
        import requests

        response = request_with_retry(
            lambda: requests.post(self.url + f"event/{import_event_id}/close"),
            f"closing import event {import_event_id}",
            self.policy,
        )
        response.raise_for_status()

    def add_file(
        self, filename: str, import_event_id: int, original_file: str
    ) -> tuple[int, Any]:
        """Upload the contents of a file to Posda."""
        import requests

        params = {
            "import_event_id": import_event_id,
            "digest": md5sum(filename),
            "localpath": original_file,
        }

        def send() -> Any:
            # Re-open per attempt: a retried upload needs a body positioned
            # back at the start of the file.
            with open(filename, "rb") as infile:
                return requests.put(self.url + "file", params=params, data=infile)

        response = request_with_retry(send, f"uploading {filename}", self.policy)
        return self._decode(response)

    def add_file_in_place(self, filename: str, import_event_id: int) -> tuple[int, Any]:
        """Register a file with Posda without moving or copying it."""
        import requests

        params = {"import_event_id": import_event_id, "localpath": filename}
        response = request_with_retry(
            lambda: requests.post(self.url + "file_in_place", params=params),
            f"importing {filename} in place",
            self.policy,
        )
        return self._decode(response)

    @staticmethod
    def _decode(response: Any) -> tuple[int, Any]:
        try:
            return response.status_code, response.json()
        except ValueError:
            return response.status_code, response.content


def get_transfer_syntax(filename: str) -> str | None:
    """Return the transfer syntax UID of a DICOM file, or None if unreadable."""
    try:
        import pydicom

        dataset = pydicom.dcmread(filename)
        return dataset.file_meta.TransferSyntaxUID
    except Exception as err:  # pydicom raises a wide variety of errors
        printe(f"Could not read transfer syntax of {filename}: {err}")
        return None


class DecompressionError(Exception):
    """gdcmconv could not convert a file to a raw transfer syntax."""


def decompress_if_needed(filename: str) -> tuple[str, str]:
    """Convert the transfer syntax of a file to raw, if needed.

    The converted file is stored in a temporary location.

    Returns (filename, original_filename). If conversion was necessary,
    filename is the temporary file, and original_filename is the original
    name prefixed with "decompressed;" -- Posda uses that prefix to record
    that the stored bytes differ from the ones on disk. If no conversion was
    needed, both values are the original filename.

    Raises DecompressionError if gdcmconv produced nothing.
    """
    syntax = get_transfer_syntax(filename)
    if syntax is None or syntax in RAW_TRANSFER_SYNTAXES:
        return filename, filename

    converted = tempfile.mktemp(prefix="posda-import")
    subprocess.run(["gdcmconv", "-w", "-i", filename, "-o", converted], check=False)

    if not os.path.exists(converted):
        raise DecompressionError(
            f"gdcmconv produced no output for transfer syntax {syntax}"
        )

    return converted, f"decompressed;{filename}"


class ImportOutcome(enum.Enum):
    """What happened to one file."""

    CREATED = "created"  # Posda stored a new file record
    EXISTING = "existing"  # Posda already had this file
    FAILED = "failed"


@dataclass(frozen=True)
class ImportResult:
    """What happened to one file, and why, if it went wrong."""

    outcome: ImportOutcome
    reason: str | None = None  # only set when the outcome is FAILED

    @classmethod
    def failure(cls, reason: str) -> ImportResult:
        return cls(ImportOutcome.FAILED, reason)


def describe_response(status: int, body: Any, limit: int = 500) -> str:
    """Describe a rejected response, without pasting a whole error page."""
    text = body.decode(errors="replace") if isinstance(body, bytes) else str(body)
    if len(text) > limit:
        text = text[:limit] + "..."
    return f"HTTP {status}: {text}"


class FailureLog:
    """Writes the entries that failed to import into a plist of their own.

    Each line is the original plist entry plus a "failure_reason", so the
    file can be handed straight back to `posda-import import` after the
    cause has been dealt with.
    """

    def __init__(self, filename: str) -> None:
        self.filename = filename
        self.count = 0
        self.outfile = open(filename, "w")

    def record(self, entry: dict[str, Any], reason: str | None) -> None:
        failed_entry = {**entry, "failure_reason": reason or "unknown"}
        self.outfile.write(json.dumps(failed_entry) + "\n")
        # Flushed per failure: a run that is killed part way through still
        # leaves behind a usable list of what had failed by then.
        self.outfile.flush()
        self.count += 1

    def close(self) -> None:
        self.outfile.close()


@dataclass
class ImportTally:
    """Running totals for an import run."""

    created: int = 0
    existing: int = 0
    failures: list[str] = field(default_factory=list)

    @property
    def imported(self) -> int:
        return self.created + self.existing

    @property
    def failed(self) -> int:
        return len(self.failures)

    def record(self, outcome: ImportOutcome, filename: str) -> None:
        if outcome is ImportOutcome.CREATED:
            self.created += 1
        elif outcome is ImportOutcome.EXISTING:
            self.existing += 1
        else:
            self.failures.append(filename)

    def summary(self) -> str:
        """One-line counts, short enough to sit inside the progress bar."""
        return (
            f"new {self.created:,}  existing {self.existing:,}  failed {self.failed:,}"
        )


def import_one_file(
    api: PosdaImportApi,
    import_event_id: int,
    entry: dict[str, Any],
    in_place: bool,
    decompress: bool,
    print_ids: bool = False,
) -> ImportResult:
    """Import a single plist entry and report what happened to it."""
    import requests

    filename = entry["filename"]

    try:
        if in_place:
            code, result = api.add_file_in_place(filename, import_event_id)
        else:
            original_file = filename
            if decompress:
                filename, original_file = decompress_if_needed(filename)
            try:
                code, result = api.add_file(filename, import_event_id, original_file)
            finally:
                if original_file.startswith("decompressed;"):
                    os.unlink(filename)
    except DecompressionError as err:
        printe(f"Decompression failed for {filename}: {err}")
        return ImportResult.failure(f"decompression failed: {err}")
    except requests.RequestException as err:
        # Every retry errored out. Give up on this file, not the whole run.
        printe(f"Giving up on {filename}: {err}")
        attempts = api.policy.retries + 1
        return ImportResult.failure(
            f"request failed after {attempts} attempt(s): "
            f"{type(err).__name__}: {err}"
        )
    except OSError as err:
        printe(f"Could not read {filename}: {err}")
        return ImportResult.failure(f"could not read file: {err}")

    if code != 200:
        description = describe_response(code, result)
        printe(f"{filename}: {description}")
        return ImportResult.failure(description)

    if print_ids:
        printo(f"{'C' if result['created'] else ' '}|{result['file_id']}")

    return ImportResult(
        ImportOutcome.CREATED if result["created"] else ImportOutcome.EXISTING
    )


def report_failures(
    failures: list[str], failure_plist: str | None, limit: int = 20
) -> None:
    """Summarize the files that could not be imported."""
    if not failures:
        return

    printe(f"\n{len(failures)} file(s) failed to import:")
    for filename in failures[:limit]:
        printe(f"    {filename}")
    if len(failures) > limit:
        printe(f"    ... and {len(failures) - limit} more")
    if failure_plist is not None:
        printe(f"Failed entries and their reasons written to {failure_plist}")


def import_plist(
    plist: str,
    base_url: str,
    comment: str,
    in_place: bool,
    decompress: bool,
    policy: RetryPolicy,
    failure_plist: str | None = DEFAULT_FAILURE_PLIST,
    print_ids: bool = False,
    show_progress: bool = True,
) -> int:
    """Import every file listed in a plist under a single import event.

    Every failure is appended to failure_plist as the original entry plus a
    "failure_reason"; pass None to keep no such record.

    Returns the number of files that failed.
    """
    global _active_progress

    total = count_lines(plist)
    api = PosdaImportApi(base_url, policy)
    import_event_id = api.create_event(comment)

    # Announce the event id before the work starts: a long import can be
    # inspected in Posda while it is still running, and if the run dies
    # this is the id you need to clean up after it.
    printe(f"Import event {import_event_id}: importing {total:,} files from {plist}")

    tally = ImportTally()
    progress = ProgressBar(total) if show_progress else None
    _active_progress = progress
    failures = FailureLog(failure_plist) if failure_plist is not None else None

    try:
        for entry in read_plist(plist):
            result = import_one_file(
                api, import_event_id, entry, in_place, decompress, print_ids
            )
            tally.record(result.outcome, entry["filename"])
            if failures is not None and result.outcome is ImportOutcome.FAILED:
                failures.record(entry, result.reason)
            if progress is not None:
                progress.advance(tally.summary())
    finally:
        if progress is not None:
            progress.close()
        _active_progress = None
        if failures is not None:
            failures.close()
        api.close_event(import_event_id)

    printe(
        f"Imported {tally.imported:,} of {total:,} files: "
        f"{tally.created:,} new, {tally.existing:,} already existing, "
        f"{tally.failed:,} failed"
    )
    report_failures(tally.failures, failure_plist)
    print(import_event_id)

    return tally.failed


