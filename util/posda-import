#!/usr/bin/env python3
"""Full disk/directory import utility for Posda.

Combines the scan/report/import workflows into a single command:

    posda-import scan /storage             # walk a tree -> files.plist
    find /storage -name '*.dcm' | \\
        posda-import scan -                # read filenames from stdin
    posda-import report files.plist        # size statistics
    posda-import import files.plist        # upload each file to Posda
    posda-import import files.plist --in-place

A "plist" is a text file with one JSON object per line, each holding the
filename, size and ctime of a file found during a scan.

Files that fail to import are written to a plist of their own (failed.plist
by default), each entry carrying an extra "failure_reason". That file is a
valid plist, so it can be fed straight back to `posda-import import` once
whatever caused the failures has been dealt with.
"""

from __future__ import annotations

import argparse
import enum
import hashlib
import json
import math
import os
import random
import shutil
import subprocess
import sys
import tempfile
import time
from collections.abc import Callable, Iterator
from dataclasses import dataclass, field
from typing import Any, TextIO

# Transfer syntaxes Posda accepts without decompression: explicit VR little
# endian, and implicit VR little endian.
RAW_TRANSFER_SYNTAXES = frozenset({"1.2.840.10008.1.2.1", "1.2.840.10008.1.2"})

DEFAULT_PLIST = "files.plist"
DEFAULT_FAILURE_PLIST = "failed.plist"
DEFAULT_BASE_URL = "http://localhost"

DEFAULT_RETRIES = 5
DEFAULT_RETRY_DELAY = 1.0
MAX_RETRY_DELAY = 60.0

# Statuses worth retrying: the request may well succeed later. Other 4xx
# responses mean Posda rejected the request itself, and retrying it
# unchanged would just fail the same way.
RETRYABLE_STATUSES = frozenset({408, 425, 429, 500, 502, 503, 504})


# The progress bar currently drawn on stderr, if any. Tracked so that log
# messages can wipe it before writing and redraw it afterwards, instead of
# leaving half a bar in the middle of the output.
_active_progress: ProgressBar | None = None


def _print_around_progress(*args: Any, stream: TextIO) -> None:
    """Write a line, wiping and redrawing the progress bar around it."""
    if _active_progress is not None:
        _active_progress.clear()
    print(*args, file=stream)
    if _active_progress is not None:
        _active_progress.render(force=True)


def printe(*args: Any) -> None:
    """Print, but to stderr, without trampling an active progress bar."""
    _print_around_progress(*args, stream=sys.stderr)


def printo(*args: Any) -> None:
    """Print to stdout without trampling an active progress bar."""
    _print_around_progress(*args, stream=sys.stdout)


