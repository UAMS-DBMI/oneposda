# progress
# ---------------------------------------------------------------------------


def format_duration(seconds: float) -> str:
    """Format a number of seconds as a compact human readable duration."""
    if seconds < 0 or not math.isfinite(seconds):
        return "--"

    seconds = int(seconds)
    hours, remainder = divmod(seconds, 3600)
    minutes, secs = divmod(remainder, 60)

    if hours:
        return f"{hours}h{minutes:02d}m"
    if minutes:
        return f"{minutes}m{secs:02d}s"
    return f"{secs}s"


class ProgressBar:
    """A single-line progress bar drawn on stderr.

    When stderr is not a terminal (a log file, a pipe) redrawing in place
    would just produce noise, so progress is emitted as ordinary lines at
    a coarse interval instead.
    """

    MIN_REDRAW_INTERVAL = 0.1  # seconds, when interactive
    LOG_INTERVAL = 0.02  # fraction of total, when not interactive

    def __init__(self, total: int, stream: TextIO | None = None) -> None:
        self.total = total
        self.stream = stream if stream is not None else sys.stderr
        self.interactive = self.stream.isatty()
        self.count = 0
        self.status = ""
        self.started = time.monotonic()
        self.last_render = 0.0
        self.last_logged_fraction = -1.0
        self.drawn = False

    @property
    def fraction(self) -> float:
        if self.total <= 0:
            return 0.0
        return min(self.count / self.total, 1.0)

    def eta(self) -> float:
        """Seconds remaining, estimated from the average rate so far."""
        elapsed = time.monotonic() - self.started
        if self.count == 0 or self.total <= 0:
            return math.inf
        return (elapsed / self.count) * max(self.total - self.count, 0)

    def advance(self, status: str = "") -> None:
        """Record one completed item and redraw if it's time to."""
        self.count += 1
        self.status = status
        self.render()

    def _line(self) -> str:
        percent = f"{self.fraction * 100:5.1f}%"
        counts = f"{self.count:,}/{self.total:,}"
        tail = f"{percent} {counts}"
        if self.status:
            tail += f"  {self.status}"
        tail += f"  eta {format_duration(self.eta())}"

        if not self.interactive:
            return tail

        # Give the bar whatever width is left over, within reason.
        width = shutil.get_terminal_size((80, 24)).columns
        bar_width = max(min(width - len(tail) - 4, 40), 10)
        filled = int(bar_width * self.fraction)
        bar = "=" * filled + " " * (bar_width - filled)
        return f"[{bar}] {tail}"

    def render(self, force: bool = False) -> None:
        now = time.monotonic()

        if self.interactive:
            if not force and now - self.last_render < self.MIN_REDRAW_INTERVAL:
                return
            self.last_render = now
            # \x1b[K clears from the cursor to the end of the line, so a
            # shorter line can't leave debris from a longer previous one.
            self.stream.write("\r" + self._line() + "\x1b[K")
            self.stream.flush()
            self.drawn = True
            return

        # Non-interactive: one line per LOG_INTERVAL of progress.
        if not force and self.fraction - self.last_logged_fraction < self.LOG_INTERVAL:
            return
        self.last_logged_fraction = self.fraction
        self.stream.write(self._line() + "\n")
        self.stream.flush()

    def clear(self) -> None:
        """Erase the bar so something else can write to the stream."""
        if self.interactive and self.drawn:
            self.stream.write("\r\x1b[K")
            self.stream.flush()
            self.drawn = False

    def close(self) -> None:
        """Draw the final state and move off the bar's line."""
        self.render(force=True)
        if self.interactive and self.drawn:
            self.stream.write("\n")
            self.stream.flush()
            self.drawn = False


def count_lines(filename: str) -> int:
    """Count the lines in a file, reading it in chunks.

    Used to give the progress bar a total. Reading the plist twice costs
    far less than holding it in memory, and a plain newline count is fast
    even for a full-disk plist.
    """
    total = 0
    ends_with_newline = True

    with open(filename, "rb") as infile:
        while chunk := infile.read(1024 * 1024):
            total += chunk.count(b"\n")
            ends_with_newline = chunk.endswith(b"\n")

    if not ends_with_newline:
        total += 1  # a final line with no trailing newline

    return total


