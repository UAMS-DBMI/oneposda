# scan
# ---------------------------------------------------------------------------


def walk_filenames(path: str) -> Iterator[str]:
    """Yield every file below path, recursively."""
    for dirpath, _dirnames, filenames in os.walk(path):
        for filename in filenames:
            yield os.path.join(dirpath, filename)


def read_filenames(stream: TextIO) -> Iterator[str]:
    """Yield filenames from a stream, one per line."""
    for line in stream:
        filename = line.strip()
        if filename:
            yield filename


def stat_file(filename: str) -> dict[str, Any] | None:
    """Return the plist entry for one file, or None if it can't be stat'ed."""
    try:
        stat = os.stat(filename)
    except OSError:
        # Some strange files can't be read; just skip them
        return None

    return {
        "filename": filename,
        "size": stat.st_size,
        "ctime": stat.st_ctime,
    }


def scan(path: str, output: str) -> None:
    """Stat every file under path and write a plist.

    A path of "-" reads the filenames from stdin instead of walking a tree.
    """
    filenames = read_filenames(sys.stdin) if path == "-" else walk_filenames(path)

    # The plist is often written into the tree being scanned; don't list it.
    output_path = os.path.abspath(output)

    written = skipped = 0
    with open(output, "w") as outfile:
        for filename in filenames:
            if os.path.abspath(filename) == output_path:
                continue
            entry = stat_file(filename)
            if entry is None:
                skipped += 1
                continue
            outfile.write(json.dumps(entry) + "\n")
            written += 1

    printe(f"Wrote {written} files to {output} ({skipped} skipped)")


