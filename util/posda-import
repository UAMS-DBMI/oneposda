def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="posda-import",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest="mode", required=True)

    scan_parser = subparsers.add_parser(
        "scan", help="walk a directory and record every file into a plist"
    )
    scan_parser.add_argument(
        "path", help='directory to walk, or "-" to read filenames from stdin'
    )
    scan_parser.add_argument(
        "-o",
        "--output",
        default=DEFAULT_PLIST,
        help=f"where to write the plist (default: {DEFAULT_PLIST})",
    )

    report_parser = subparsers.add_parser(
        "report", help="print size statistics for a plist"
    )
    report_parser.add_argument("plist", nargs="?", default=DEFAULT_PLIST)

    import_parser = subparsers.add_parser(
        "import", help="import every file in a plist into Posda"
    )
    import_parser.add_argument("plist", nargs="?", default=DEFAULT_PLIST)
    import_parser.add_argument(
        "--in-place",
        action="store_true",
        help="register files where they are instead of uploading their contents",
    )
    import_parser.add_argument(
        "--decompress",
        action="store_true",
        help="convert non-raw transfer syntaxes with gdcmconv before uploading",
    )
    import_parser.add_argument(
        "-f",
        "--failures",
        default=DEFAULT_FAILURE_PLIST,
        help=(
            "plist to write failed entries to, each with a failure_reason "
            f"(default: {DEFAULT_FAILURE_PLIST})"
        ),
    )
    import_parser.add_argument(
        "--no-failures",
        action="store_true",
        help="don't write a plist of failed entries",
    )
    import_parser.add_argument("--base-url", default=DEFAULT_BASE_URL)
    import_parser.add_argument("--comment", default="CLI API Import")
    import_parser.add_argument(
        "--retries",
        type=int,
        default=DEFAULT_RETRIES,
        help=f"retries after a failed request (default: {DEFAULT_RETRIES}, 0 disables)",
    )
    import_parser.add_argument(
        "--retry-delay",
        type=float,
        default=DEFAULT_RETRY_DELAY,
        help=(
            "seconds before the first retry, doubling each time up to "
            f"{MAX_RETRY_DELAY:.0f}s (default: {DEFAULT_RETRY_DELAY})"
        ),
    )
    import_parser.add_argument(
        "--print-ids",
        action="store_true",
        help="print 'C|<file_id>' on stdout for every file, as older versions did",
    )
    import_parser.add_argument(
        "--no-progress", action="store_true", help="don't draw the progress bar"
    )

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.mode == "scan":
        scan(args.path, args.output)
    elif args.mode == "report":
        report(args.plist)
    elif args.mode == "import":
        if args.in_place and args.decompress:
            parser.error(
                "--decompress cannot be used with --in-place: an in-place import "
                "reads the file from disk, so a decompressed copy would be ignored"
            )
        if args.retries < 0:
            parser.error("--retries cannot be negative")

        failure_plist = None if args.no_failures else args.failures
        if failure_plist is not None and os.path.abspath(
            failure_plist
        ) == os.path.abspath(args.plist):
            parser.error(
                "--failures cannot be the plist being imported: it is truncated "
                "when the import starts"
            )

        failed = import_plist(
            args.plist,
            args.base_url,
            args.comment,
            args.in_place,
            args.decompress,
            RetryPolicy(retries=args.retries, delay=args.retry_delay),
            failure_plist=failure_plist,
            print_ids=args.print_ids,
            show_progress=not args.no_progress,
        )
        # Non-zero exit so a wrapping script can notice an incomplete import.
        return 1 if failed else 0

    return 0


if __name__ == "__main__":
    sys.exit(main())
